{
  "name": "fantasyfb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0",
    "python": ">=3.9"
  },
  "scripts": {
    "build": "pnpm --filter @fantasyfb/web build",
    "dev": "pnpm --filter @fantasyfb/web dev",
    "lint": "pnpm exec eslint . --max-warnings 0",
    "format": "pnpm exec prettier --write .",
    "format:check": "pnpm exec prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:python": "if [ -x .venv/bin/python ]; then .venv/bin/python -m pytest pipelines; else python3 -m pytest pipelines; fi",
    "test:e2e": "pnpm --filter @fantasyfb/web exec playwright test",
    "fixtures:validate": "pnpm --filter @fantasyfb/web exec vitest run src/fixtures/public-demo.test.ts src/server/public-route-boundary.test.ts",
    "boundaries": "node scripts/validate-import-boundaries.mjs",
    "db:generate": "pnpm --filter @fantasyfb/database exec drizzle-kit generate",
    "db:migrate": "pnpm --filter @fantasyfb/database db:migrate",
    "db:migrations:check": "pnpm --filter @fantasyfb/database db:migrations:check",
    "db:validate": "pnpm --filter @fantasyfb/database db:validate",
    "db:seed": "pnpm --filter @fantasyfb/database db:seed",
    "db:test:reset": "pnpm --filter @fantasyfb/database db:test:reset",
    "adp:ingest": "pnpm --filter @fantasyfb/adp-pipeline ingest",
    "news:ingest": "pnpm --filter @fantasyfb/news-pipeline ingest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
