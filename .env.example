# Pooled runtime connection. Use the Neon `-pooler` endpoint for Vercel functions.
DATABASE_URL=
# Direct connection for migrations, pg_dump, and restore validation. Never expose either URL publicly.
DATABASE_DIRECT_URL=

# Required only when the Better Auth private workspace is enabled.
# Configure GitHub OAuth with the callback URL:
# ${NEXT_PUBLIC_APP_URL}/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated immutable GitHub user IDs. Do not use usernames, email addresses, or display names.
AUTHORIZED_GITHUB_USER_IDS=

# Optional licensed expert API. The provider remains disabled unless both values exist,
# the URL uses HTTPS, and the upstream returns the documented normalized JSON contract.
EXPERT_API_PROVIDER_NAME=
EXPERT_API_URL=
EXPERT_API_TOKEN=

# Disabled until each API/feed has a documented reuse basis and excerpt policy.
# Keep tokens out of NEWS_SOURCES_JSON.
NEWS_SOURCES_JSON=[]
NEWS_SOURCE_TOKENS_JSON={}

# Public, browser-safe application origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required by scheduled production ADP ingestion. This is explicit configuration, not a secret.
# Example: [{"scoringFormat":"ppr","leagueSize":10},{"scoringFormat":"ppr","leagueSize":12}]
ADP_CONTEXTS_JSON=
TARGET_SEASON=2026
