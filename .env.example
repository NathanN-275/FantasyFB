# Required only for database-backed capabilities.
DATABASE_URL=

# Required only when the Better Auth private workspace is enabled.
# Configure GitHub OAuth with the callback URL:
# ${NEXT_PUBLIC_APP_URL}/api/auth/callback/github
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated immutable GitHub user IDs. Do not use usernames, email addresses, or display names.
AUTHORIZED_GITHUB_USER_IDS=

# Optional licensed expert API. The provider remains disabled unless both values exist,
# the URL uses HTTPS, and the upstream returns the documented normalized JSON contract.
EXPERT_API_PROVIDER_NAME=
EXPERT_API_URL=
EXPERT_API_TOKEN=

# Public, browser-safe application origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
